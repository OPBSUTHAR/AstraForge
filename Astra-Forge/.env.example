# ---- Server ----
PORT=4000
NODE_ENV=development

# MongoDB connection string (Phase 1: project states + model histories)
MONGODB_URI=mongodb://localhost:27017/astraforge

# Local storage roots for uploaded images / generated meshes
UPLOAD_DIR=./storage/uploads
MESH_DIR=./storage/meshes

# ---- AI / ML services (see services/) ----
# Vision API bridge (background removal + image-to-mesh)
VISION_SERVICE_URL=http://localhost:5001

# C++ geometry engine bridge (mesh repair + Lego joints)
GEOMETRY_SERVICE_URL=http://localhost:5002

# Karmashala CLI (Ollama-powered assistant)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Mongo (Docker helper) ----
# docker run -d -p 27017:27017 --name astraforge-mongo mongo:7